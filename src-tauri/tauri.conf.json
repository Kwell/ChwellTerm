{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChwellTerm",
  "version": "0.9.2",
  "identifier": "dev.terminalworkbench.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ChwellTerm", "theme": "Dark", "width": 1280, "height": 820, "minWidth": 760, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "shortDescription": "ChwellTerm cross-platform SSH terminal",
    "category": "DeveloperTool"
  }
}
